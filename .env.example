# =====================================================================
# ITAM — Gestão de Ativos de TI
# Valores abaixo são didáticos, para uso exclusivo em laboratório.
# =====================================================================

# ---------------- Ambiente ----------------
# local | docker | producao  (fora de "local", SECRET_KEY padrão é recusada)
ENVIRONMENT=local
API_PORT=8000
LOG_LEVEL=INFO
# Raiz dos datasets (CSVs, esquemas, raw/processed). Default: dataset/ na raiz
# do repositório. Em Docker é definido no docker-compose.yml (/dataset).
DATASET_DIR=

# ---------------- Banco de dados ----------------
# Execução local sem Docker (SQLite):
DATABASE_URL=sqlite:///./itam.db
# Execução com Docker (o host é "db", não "localhost"):
# DATABASE_URL=postgresql+psycopg://itam:itam_lab@db:5432/itam

POSTGRES_USER=itam
POSTGRES_PASSWORD=itam_lab
POSTGRES_DB=itam
POSTGRES_PORT=5432

# ---------------- Segurança / JWT (FR-015) ----------------
# Gere uma chave própria com:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-esta-chave
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------- Usuários de demonstração (seed) ----------------
SEED_ADMIN_PASSWORD=admin
SEED_OPERADOR_PASSWORD=operador
SEED_GESTOR_PASSWORD=gestor
SEED_AUDITOR_PASSWORD=auditor

# ---------------- Observabilidade (FR-014) ----------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=grafana_lab
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090

# ---------------- Coleta de dados públicos ----------------
# Compras.gov e endoflife.date não exigem chave.
COMPRAS_GOV_BASE_URL=https://dadosabertos.compras.gov.br
ENDOFLIFE_BASE_URL=https://endoflife.date/api
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
# Chave gratuita: https://nvd.nist.gov/developers/request-an-api-key
# Sem ela a coleta funciona, mas com limite de requisições bem menor.
NVD_API_KEY=
COLLECTOR_TIMEOUT_SECONDS=30
COLLECTOR_REQUEST_DELAY_SECONDS=1

# ---------------- Dados sintéticos (FR-002, FR-005) ----------------
# Chave em https://www.mockaroo.com/ -> My Account -> API Key
MOCKAROO_API_KEY=
# Semente usada pelo ETL ao gerar transferências, baixas e instalações
SYNTHETIC_SEED=42